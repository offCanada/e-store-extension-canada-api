# Copy to `.env` and adjust as needed. All values below match the code defaults
# (app/configs/settings.py) — the app runs fine without a .env file at all.
# Full reference: docs/configuration.md

# Path to the DuckDB database file. Relative paths resolve against your current
# working directory; prefer an absolute path when overriding.
DB_PATH=app/data/nutrilens.duckdb

# Open DuckDB read-only (recommended). The file must exist when true — DuckDB
# cannot create a new database in read-only mode.
READ_ONLY=true

# Origins allowed by CORS (JSON list). Restrict in production, e.g.:
# ALLOWED_ORIGINS=["chrome-extension://your-extension-id"]
ALLOWED_ORIGINS=["*"]
